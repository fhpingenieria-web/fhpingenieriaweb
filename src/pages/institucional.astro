---
import PaginaTema from "@/components/layout/PaginaTema.astro";
import T from "@/components/ui/T.astro";
import CabSeccion from "@/components/ui/CabSeccion.astro";
import GrillaFotos from "@/components/ui/GrillaFotos.astro";
import { inicio, sitio, temas } from "@/lib/textos";
import experiencia from "@/assets/temas/experiencia.jpg";
import compromiso from "@/assets/temas/compromiso.jpg";
import sustentabilidad from "@/assets/temas/sustentabilidad.jpg";

const d = temas.institucional;
const dt = inicio.direccionTecnica;
const k = "temas.institucional";
const grilla = [
  { href: "/experiencia/", foto: experiencia, k: "sitio.menu.experiencia", titulo: sitio.menu.experiencia },
  { href: "/compromiso/", foto: compromiso, k: "sitio.menu.compromiso", titulo: sitio.menu.compromiso },
  { href: "/sustentabilidad/", foto: sustentabilidad, k: "sitio.menu.sustentabilidad", titulo: sitio.menu.sustentabilidad },
];
---

<PaginaTema tema="institucional">
  <section class="contenedor seccion ins" aria-label={d.palabra}>
    <div class="ins-bloque ins-ancho">
      <h2><T k={`${k}.tituloQuienes`} v={d.tituloQuienes} /></h2>
      <p class="t-lead"><T k="sitio.descripcionInstitucional" v={sitio.descripcionInstitucional} /></p>
    </div>
    <div class="ins-bloque">
      <h2><T k={`${k}.tituloMision`} v={d.tituloMision} /></h2>
      <p><T k="inicio.direccionTecnica.mision" v={dt.mision} /></p>
    </div>
    <div class="ins-bloque">
      <h2><T k={`${k}.tituloVision`} v={d.tituloVision} /></h2>
      <p><T k={`${k}.vision`} v={d.vision} /></p>
    </div>
    <div class="ins-bloque ins-ancho">
      <h2><T k={`${k}.tituloValores`} v={d.tituloValores} /></h2>
      <ul role="list" class="ins-valores">{dt.valores.map((x, i) => <li><T k={`inicio.direccionTecnica.valores.${i}`} v={x} /></li>)}</ul>
    </div>
  </section>

  <section class="contenedor ins-grilla" aria-label="Más sobre FHP">
    <CabSeccion id="ins-mas" titulo={inicio.grillaInstitucional.titulo} tk="inicio.grillaInstitucional.titulo" centrada />
    <GrillaFotos items={grilla} />
  </section>
</PaginaTema>

<style>
  .ins { display: grid; gap: var(--s-7); }
  .ins-bloque { display: grid; gap: var(--s-3); align-content: start; padding-top: var(--s-4); border-top: var(--filete-fuerte) solid var(--senal); }
  .ins-bloque h2 { font-size: var(--t-2); font-weight: 600; line-height: 1.2; letter-spacing: -0.015em; }
  .ins-bloque p { color: var(--grafito); max-width: 60ch; }
  .ins-valores { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-2); }
  .ins-valores li { padding: 8px 14px; border-radius: var(--r-pastilla); background: var(--superficie); box-shadow: inset 0 0 0 1px var(--linea); font-size: var(--t-small); font-weight: 500; }
  .ins-grilla { padding-bottom: var(--seccion); }
  @media (min-width: 768px) {
    .ins { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7); }
    .ins-ancho { grid-column: 1 / -1; }
  }
</style>
