---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import Migas from "@/components/layout/Migas.astro";
import Contacto from "@/components/home/Contacto.astro";
import Icon from "@/components/ui/Icon.astro";
import T from "@/components/ui/T.astro";
import { creditosSectores } from "@/data/creditos";

export async function getStaticPaths() {
  const sectores = (await getCollection("sectores")).sort((a, b) => a.data.orden - b.data.orden);
  const servicios = await getCollection("servicios");

  return sectores.map((sector, indice) => {
    const serviciosDelSector = new Set<string>(sector.data.servicios);
    return {
      params: { slug: sector.data.ruta },
      props: {
        sector,
        siguiente: sectores[(indice + 1) % sectores.length]!,
        servicios: servicios
          .filter((servicio) => serviciosDelSector.has(servicio.id))
          .sort((a, b) => a.data.orden - b.data.orden),
      },
    };
  });
}

interface Props {
  sector: CollectionEntry<"sectores">;
  siguiente: CollectionEntry<"sectores">;
  servicios: CollectionEntry<"servicios">[];
}

const { sector, siguiente, servicios } = Astro.props;
const d = sector.data;
const fotos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/sectores/*.jpg", { eager: true });
const foto = fotos[`/src/assets/sectores/${d.imagen}.jpg`]!.default;
const fotoSiguiente = fotos[`/src/assets/sectores/${siguiente.data.imagen}.jpg`]!.default;
const credito = creditosSectores[d.imagen];
---

<Base titulo={d.nombre} descripcion={d.metaDescripcion} imagen="/og/sectores.png">
  <article>
    <header class="sd-cab">
      <div class="sd-escena">
        <Picture class="sd-fondo" src={foto} alt={credito.descripcion} formats={["avif", "webp"]} widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
        <div class="sd-panel vidrio vidrio--denso">
          <Migas items={[{ nombre: "Inicio", href: "/" }, { nombre: "Sectores", href: "/sectores/" }, { nombre: d.nombre }]} />
          <h1 class="t-display sd-titulo"><T k={`sectores.${sector.id}.nombre`} v={d.nombre} /></h1>
          <p class="sd-intro"><T k={`sectores.${sector.id}.introduccion`} v={d.introduccion} /></p>
          <a class="btn" href="#contacto">Consultar por este sector <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
    </header>

    <div class="sd-cuerpo contenedor seccion">
      <section class="sd-bloque" aria-labelledby="sd-necesidades">
        <p class="t-label">El contexto</p>
        <h2 id="sd-necesidades" class="sd-h2">Necesidades habituales</h2>
        <ul role="list" class="sd-lista">
          {d.necesidades.map((item, i) => <li><Icon name="check" size={18} /><T k={`sectores.${sector.id}.necesidades.${i}`} v={item} /></li>)}
        </ul>
      </section>

      <section class="sd-bloque" aria-labelledby="sd-acompanamiento">
        <p class="t-label">El aporte de FHP</p>
        <h2 id="sd-acompanamiento" class="sd-h2">Cómo acompañamos</h2>
        <ul role="list" class="sd-lista">
          {d.acompanamiento.map((item, i) => <li><Icon name="check" size={18} /><T k={`sectores.${sector.id}.acompanamiento.${i}`} v={item} /></li>)}
        </ul>
      </section>
    </div>

    <section class="sd-servicios contenedor" aria-labelledby="sd-servicios">
      <div class="sd-servicios-cab">
        <p class="t-label">Alcances posibles</p>
        <h2 id="sd-servicios" class="t-h2">Servicios relacionados</h2>
      </div>
      <ul role="list" class="sd-servicios-lista">
        {servicios.map((servicio) => (
          <li>
            <a href={`/servicios/${servicio.id}/`}>
              <span><T k={`servicios.${servicio.id}.titulo`} v={servicio.data.titulo} /></span>
              <Icon name="arrow-up-right" size={20} />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <nav class="sd-siguiente contenedor" aria-label="Siguiente sector">
      <a class="sd-sig-tarjeta" href={`/sectores/${siguiente.data.ruta}/`}>
        <Picture class="sd-sig-foto" src={fotoSiguiente} alt="" formats={["avif", "webp"]} widths={[640, 960, 1400]} sizes="100vw" loading="lazy" decoding="async" />
        <span class="sd-sig-panel vidrio vidrio--denso">
          <span class="sd-sig-titulo"><T k={`sectores.${siguiente.id}.nombre`} v={siguiente.data.nombre} /> <Icon name="arrow-right" size={28} /></span>
          <span class="t-label">Siguiente sector</span>
        </span>
      </a>
    </nav>
  </article>

  <Contacto servicio={d.nombreCorto} />
</Base>

<style>
  .sd-cab { padding: var(--s-4) 12px 0; }
  .sd-escena { position: relative; isolation: isolate; overflow: hidden; min-height: min(820px, 100svh); border-radius: var(--r-panel); display: grid; align-items: end; padding: var(--s-8) 12px 12px; background: var(--linea); }
  .sd-escena :global(img.sd-fondo) { filter: var(--foto-filtro); position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; }
  .sd-panel { width: min(100%, 720px); padding: var(--s-6) var(--s-5); display: grid; justify-items: start; gap: var(--s-5); }
  .sd-panel > * { position: relative; z-index: 2; }
  .sd-titulo { max-width: 16ch; }
  .sd-intro { max-width: 62ch; color: var(--grafito); line-height: 1.65; }

  .sd-cuerpo { display: grid; gap: var(--s-8) var(--col-gap); }
  .sd-bloque { display: grid; align-content: start; gap: var(--s-3); padding-top: var(--s-4); border-top: var(--filete-fuerte) solid var(--senal); }
  .sd-h2 { font-size: var(--t-3); font-weight: 600; line-height: 1.12; letter-spacing: -0.02em; }
  .sd-lista { margin-top: var(--s-3); }
  .sd-lista li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--s-3); padding: var(--s-4) 0; color: var(--grafito); }
  .sd-lista li + li { border-top: var(--filete) solid rgb(14 18 21 / 0.1); }
  .sd-lista :global(.icon) { color: var(--senal-texto); transform: translateY(4px); }

  .sd-servicios { padding-bottom: var(--seccion); display: grid; gap: var(--s-7); }
  .sd-servicios-cab { display: grid; gap: var(--s-3); }
  .sd-servicios-lista { border-top: var(--filete) solid var(--linea); }
  .sd-servicios-lista a { min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: var(--s-4) 0; border-bottom: var(--filete) solid var(--linea); text-decoration: none; font-weight: 600; }
  .sd-servicios-lista a:hover { color: var(--senal-texto); }
  .sd-servicios-lista :global(.icon) { flex: none; transition: transform var(--dur-2) var(--ease-out); }
  .sd-servicios-lista a:hover :global(.icon), .sd-servicios-lista a:focus-visible :global(.icon) { transform: translate(3px, -3px); }

  .sd-sig-tarjeta { position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: end; min-height: 360px; padding: 12px; border-radius: var(--r-panel); text-decoration: none; background: var(--linea); }
  .sd-sig-tarjeta :global(img.sd-sig-foto) { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .sd-sig-tarjeta:hover :global(img.sd-sig-foto) { transform: scale(1.04); }
  .sd-sig-panel { display: grid; gap: var(--s-2); padding: var(--s-5); width: min(100%, 680px); }
  .sd-sig-panel > * { position: relative; z-index: 2; }
  .sd-sig-titulo { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); font-size: var(--t-3); font-weight: var(--w-titular); line-height: 1.1; }
  .sd-sig-titulo :global(.icon) { flex: none; color: var(--senal-texto); }

  @media (min-width: 768px) {
    .sd-cab { padding: var(--s-5) var(--gutter) 0; }
    .sd-escena { padding: var(--s-9) var(--s-5) var(--s-5); }
    .sd-panel { padding: var(--s-7); }
    .sd-cuerpo { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .sd-escena { align-items: center; }
    .sd-servicios { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sd-servicios-lista :global(.icon), .sd-sig-tarjeta :global(img.sd-sig-foto) { transition: none; }
  }
</style>
