---
import T from "@/components/ui/T.astro";
import { inicio } from "@/lib/textos";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { creditosSectores } from "@/data/creditos";
import Icon from "@/components/ui/Icon.astro";
import { obrasPublicadas } from "@/lib/obras";
import CabSeccion from "@/components/ui/CabSeccion.astro";


const fotos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/sectores/*.jpg", { eager: true });
const sectores = (await getCollection("sectores")).sort((a, b) => a.data.orden - b.data.orden);
const hayObras = (await obrasPublicadas()).length > 0;
const { sinCabecera = false } = Astro.props as { sinCabecera?: boolean };
---

<section class="sec contenedor seccion" id="sectores" aria-label={inicio.sectores.titulo}>
  {!sinCabecera && <CabSeccion
    id="sec-titulo"
    titulo={inicio.sectores.titulo}
    bajada={inicio.sectores.bajada}
    tk="inicio.sectores.titulo"
    bk="inicio.sectores.bajada"
  />}

  <div class="sec-grilla">
    {
      sectores.map((s, i) => {
        const c = creditosSectores[s.data.imagen];
        return (
          <article class:list={["sec-item", `sec-item-${i}`]}>
            <Picture
              src={fotos[`/src/assets/sectores/${s.data.imagen}.jpg`]!.default}
              alt={c.descripcion}
              formats={["avif", "webp"]}
              widths={[480, 720, 960, 1400]}
              sizes={i === 0 ? "(min-width: 1024px) 58vw, 100vw" : "(min-width: 1024px) 40vw, 100vw"}
              loading="lazy" fetchpriority="low"
              decoding="async"
            />
            <a class="sec-enlace" href={`/sectores/${s.data.ruta}/`} aria-label={`Conocer el sector ${s.data.nombre}`}>
              <div class="sec-texto vidrio vidrio--denso">
                <h3 class="sec-nombre">
                  <Icon name={s.data.imagen} size={22} />
                  <T k={`sectores.${s.id}.nombre`} v={s.data.nombre} />
                </h3>
                <p><T k={`sectores.${s.id}.descripcion`} v={s.data.descripcion} /></p>
                <span class="sec-ver">Conocer el sector <Icon name="arrow-right" size={18} /></span>
              </div>
            </a>
          </article>
        );
      })
    }
  </div>
  <p class="sec-nota">
    <T k="inicio.sectores.nota" v={inicio.sectores.nota} />
    {hayObras && <a href="/obras/"><T k="inicio.sectores.enlaceObras" v={inicio.sectores.enlaceObras} /></a>}
  </p>
</section>

<style>
  .sec-grilla { display: grid; gap: var(--col-gap); }
  .sec-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-panel);
    background: var(--linea);
    aspect-ratio: 4 / 5;
    display: grid;
    align-items: end;
    isolation: isolate;
  }
  .sec-item :global(picture) { position: absolute; inset: 0; z-index: -1; }
  .sec-item :global(img) { filter: var(--foto-filtro);
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .sec-item:hover :global(img) { transform: scale(1.04); }
  .sec-enlace { display: grid; align-items: end; height: 100%; color: inherit; text-decoration: none; }
  .sec-texto {
    margin: 12px;
    padding: var(--s-5);
    border-radius: calc(var(--r-panel) - 12px);
    display: grid;
    gap: var(--s-2);
  }
  .sec-texto > * { position: relative; z-index: 2; }
  .sec-nombre { display: flex; align-items: center; gap: var(--s-3); font-size: var(--t-2); font-weight: 520; letter-spacing: -0.015em; line-height: 1.15; }
  .sec-nombre :global(.icon) { color: var(--senal-texto); flex: none; }
  .sec-texto p { color: var(--grafito); max-width: 40ch; }
  .sec-ver { display: inline-flex; align-items: center; gap: var(--s-2); margin-top: var(--s-2); color: var(--senal-texto); font-size: var(--t-small); font-weight: 600; }
  .sec-ver :global(.icon) { transition: transform var(--dur-2) var(--ease-out); }
  .sec-enlace:hover .sec-ver :global(.icon), .sec-enlace:focus-visible .sec-ver :global(.icon) { transform: translateX(4px); }
  .sec-nota { margin-top: var(--s-5); font-size: var(--t-label); color: var(--grafito); }

  @media (min-width: 768px) {
    .sec-item { aspect-ratio: 16 / 11; }
  }
  @media (min-width: 1024px) {
    .sec-grilla { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-rows: 1fr 1fr; }
    .sec-item { aspect-ratio: auto; min-height: 340px; }
    .sec-item-0 { grid-row: span 2; min-height: 720px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sec-item :global(img), .sec-ver :global(.icon) { transition: none; }
  }
</style>
