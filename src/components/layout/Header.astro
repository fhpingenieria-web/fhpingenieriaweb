---
import T from "@/components/ui/T.astro";
import { sitio } from "@/lib/textos";
import Logo from "@/components/brand/Logo.astro";
import Icon from "@/components/ui/Icon.astro";
import MenuMovil from "./MenuMovil.astro";
import { obrasParaMostrar } from "@/lib/obras";
import { emailUrl, emailVisible, telUrl, telefonoVisible } from "@/lib/contacto";
import { getCollection } from "astro:content";

const obrasNav = await obrasParaMostrar();
const servicios = (await getCollection("servicios")).sort((a, b) => a.data.orden - b.data.orden);
const sectores = (await getCollection("sectores")).sort((a, b) => a.data.orden - b.data.orden);
const pasosMetodo = (await getCollection("metodo")).sort((a, b) => a.data.orden - b.data.orden);
const m = sitio.menu;
const nav = [
  { href: "/", label: m.inicio, k: "sitio.menu.inicio" },
  {
    href: "/institucional/",
    label: m.institucional,
    k: "sitio.menu.institucional",
    sub: [
      { href: "/experiencia/", label: m.experiencia, k: "sitio.menu.experiencia" },
      { href: "/compromiso/", label: m.compromiso, k: "sitio.menu.compromiso" },
      { href: "/sustentabilidad/", label: m.sustentabilidad, k: "sitio.menu.sustentabilidad" },
    ],
  },
  {
    href: "/servicios/",
    label: m.servicios,
    k: "sitio.menu.servicios",
    sub: servicios.map((s) => ({ href: `/servicios/${s.id}/`, label: s.data.titulo, k: `servicios.${s.id}.titulo` })),
  },
  {
    href: "/sectores/",
    label: m.sectores,
    k: "sitio.menu.sectores",
    sub: sectores.map((s) => ({ href: `/sectores/${s.data.ruta}/`, label: s.data.nombre, k: `sectores.${s.id}.nombre` })),
  },
  ...(obrasNav.obras.length ? [{ href: obrasNav.base, label: m.obras, k: "sitio.menu.obras" }] : []),
  {
    href: "/metodo/",
    label: m.metodo,
    k: "sitio.menu.metodo",
    sub: pasosMetodo.map((p) => ({ href: `/metodo/${p.id}/`, label: p.data.nombre, k: `metodo.${p.id}.nombre` })),
  },
  { href: "/equipo/", label: m.equipo, k: "sitio.menu.equipo" },
  { href: "/contacto/", label: m.contacto, k: "sitio.menu.contacto" },
];

interface Props {
  /** Página con foto arriba: la cabecera flota sobre la imagen y toma fondo al bajar. */
  sobreImagen?: boolean;
}
const { sobreImagen = false } = Astro.props;
const path = Astro.url.pathname;
const actual = (href: string) => ((href === "/" ? path === "/" : path.startsWith(href)) ? "page" : undefined);
---

<header class:list={["cabecera", { "cabecera-sobre": sobreImagen }]} data-cabecera>
  <div class="franja">
    <div class="contenedor franja-in">
      <a href={emailUrl}><Icon name="envelope" size={15} /> {emailVisible}</a>
      <a href={telUrl}><Icon name="phone" size={15} /> {telefonoVisible}</a>
    </div>
  </div>
  <div class="barra">
    <div class="contenedor cabecera-in">
      <a href="/" class="cabecera-logo" aria-label="FHp Ingeniería y Consultoría, inicio">
        <Logo alto={58} descriptor class="logo-largo" />
        <Logo alto={46} class="logo-corto" />
      </a>

      <nav class="cabecera-nav" aria-label="Principal">
        <ul role="list">
          {
            nav.map((n) => (
              <li class:list={{ "tiene-sub": n.sub }}>
                <a class="nav-a" href={n.href} aria-current={actual(n.href)}>
                  <T k={n.k} v={n.label} />
                  {n.sub && <svg class="nav-flecha" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>}
                </a>
                {n.sub && (
                  <ul role="list" class="sub">
                    {n.sub.map((s) => <li><a href={s.href}><T k={s.k} v={s.label} /></a></li>)}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <button class="cabecera-menu" popovertarget="menu-movil" aria-label="Abrir menú">
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

  <MenuMovil nav={nav} />
</header>

<!-- La cabecera flota: en las páginas sin foto arriba, este espacio le guarda su lugar -->
{!sobreImagen && <div class="cabecera-espacio" aria-hidden="true"></div>}

<script>
  // Al bajar, la cabecera se va para no tapar el contenido; al subir vuelve, finita y azul.
  const cab = document.querySelector("[data-cabecera]");
  if (cab) {
    let ultimo = scrollY;
    let pendiente = false;
    const actualizar = () => {
      pendiente = false;
      const y = scrollY;
      cab.classList.toggle("con-fondo", y > 24);
      if (y > ultimo + 6 && y > 160) cab.classList.add("oculta");
      else if (y < ultimo - 6 || y <= 160) cab.classList.remove("oculta");
      if (Math.abs(y - ultimo) > 6) ultimo = y;
    };
    addEventListener("scroll", () => { if (!pendiente) { pendiente = true; requestAnimationFrame(actualizar); } }, { passive: true });
    actualizar();
  }
</script>

<style>
  .cabecera-espacio { height: calc(var(--franja-h) + var(--header-h)); }
  /* Flota siempre. Sin JS queda al principio de la página y no acompaña. */
  .cabecera { position: fixed; inset: 0 0 auto; z-index: var(--z-header); color: var(--tinta); transition: transform var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out); }
  :global(html:not(.js)) .cabecera { position: absolute; }
  /* Sobre una foto: en blanco, con una sombra suave para que se lea */
  .cabecera-sobre { color: #fff; background: linear-gradient(180deg, rgb(6 18 40 / 0.72), rgb(6 18 40 / 0.34) 70%, transparent); }
  /* Al bajar se esconde; al subir vuelve finita y azul noche, sin franja, para tapar lo menos posible.
     Con el teclado siempre vuelve a mostrarse, para que el foco nunca quede oculto. */
  .cabecera:global(.con-fondo) { background: rgb(10 31 63 / 0.97); color: #fff; }
  .cabecera:global(.oculta):not(:focus-within) { transform: translateY(-100%); }
  .cabecera:global(.con-fondo) .franja { display: none; }
  .cabecera:global(.con-fondo) .cabecera-in { height: 60px; }
  .cabecera:global(.con-fondo) :global(.logo) { height: 40px; width: auto; }

  /* Franja con mail y teléfono */
  .franja { border-bottom: var(--filete) solid var(--linea); font-size: 0.8125rem; font-weight: 500; }
  .cabecera-sobre .franja { border-bottom-color: rgb(255 255 255 / 0.2); }
  .franja-in { min-height: var(--franja-h); display: flex; align-items: center; justify-content: flex-end; gap: var(--s-5); }
  .franja a { display: inline-flex; align-items: center; gap: 6px; min-height: 24px; color: inherit; text-decoration: none; white-space: nowrap; }
  .franja a:hover { text-decoration: underline; text-underline-offset: 0.25em; }

  .cabecera-in { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); }
  .cabecera-logo { color: inherit; display: inline-flex; flex: none; padding-block: 4px; }
  .cabecera-logo :global(.logo-corto) { display: none; }

  .cabecera-nav > ul { display: flex; align-items: center; gap: var(--s-5); }
  .cabecera-nav li { position: relative; }
  .nav-a { position: relative; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: 0.875rem; font-weight: 600; color: inherit; text-decoration: none; white-space: nowrap; }
  .nav-flecha { opacity: 0.7; transition: transform var(--dur-1) var(--ease-out); }
  .nav-a::after { content: ""; position: absolute; left: 0; right: 0; bottom: 7px; height: 2px; background: var(--senal); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-2) var(--ease-out); }
  .nav-a:hover::after, .nav-a[aria-current="page"]::after { transform: scaleX(1); }

  /* Desplegables: abren al pasar el cursor o al llegar con el teclado */
  .sub { position: absolute; top: 100%; left: -14px; min-width: 260px; padding: var(--s-2); background: var(--superficie); color: var(--tinta); border-radius: var(--r-panel); box-shadow: 0 0 0 1px var(--linea), 0 16px 32px -16px rgb(10 31 63 / 0.4); opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out), visibility var(--dur-1); }
  .tiene-sub:hover .sub, .tiene-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .tiene-sub:hover .nav-flecha, .tiene-sub:focus-within .nav-flecha { transform: rotate(180deg); }
  .sub a { display: block; padding: 10px 12px; border-radius: var(--r-pastilla); font-size: 0.875rem; font-weight: 500; line-height: 1.3; color: inherit; text-decoration: none; }
  .sub a:hover, .sub a:focus-visible { background: var(--banda); color: var(--senal-texto); }

  .cabecera-menu { display: none; width: 44px; height: 44px; place-items: center; color: inherit; }

  @media (max-width: 1099.98px) {
    .cabecera-nav { display: none; }
    .cabecera-menu { display: grid; }
  }
  @media (max-width: 479.98px) {
    .cabecera-logo :global(.logo-largo) { display: none; }
    .cabecera-logo :global(.logo-corto) { display: block; }
    .franja { font-size: 0.75rem; }
    .franja-in { justify-content: space-between; gap: var(--s-2); }
    .franja a { gap: 4px; }
    .franja :global(.icon) { width: 13px; height: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cabecera, .nav-a::after, .nav-flecha, .sub { transition: none; }
  }
</style>
