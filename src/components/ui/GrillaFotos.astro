---
/** Grilla de fotos con el título encima: cada una abre su página. Tres por fila; las que sobran quedan centradas. */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import T from "@/components/ui/T.astro";

interface Props {
  items: { href: string; foto: ImageMetadata; k: string; titulo: string }[];
}
const { items } = Astro.props;
---

<ul role="list" class="gf">
  {
    items.map((it) => (
      <li>
        <a class="gf-item" href={it.href}>
          <Picture class="gf-foto" src={it.foto} alt="" formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw" loading="lazy" fetchpriority="low" decoding="async" />
          <span class="gf-titulo"><T k={it.k} v={it.titulo} /></span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .gf { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-4); }
  .gf > li { flex: 1 1 100%; }
  .gf-item { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--r-foto); color: #fff; text-decoration: none; isolation: isolate; background: var(--tinta); }
  .gf-item :global(picture) { position: absolute; inset: 0; z-index: -2; }
  .gf-item :global(.gf-foto) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; filter: var(--foto-filtro); transition: transform var(--dur-3) var(--ease-out); }
  .gf-item::after { content: ""; position: absolute; inset: 0; z-index: -1; background: rgb(6 18 40 / 0.5); transition: background-color var(--dur-2) var(--ease-out); }
  .gf-item:hover::after, .gf-item:focus-visible::after { background: rgb(11 61 145 / 0.62); }
  .gf-item:hover :global(.gf-foto) { transform: scale(1.04); }
  .gf-titulo { grid-area: 1 / 1; padding: var(--s-4); text-align: center; font-size: var(--t-2); font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; text-wrap: balance; text-shadow: 0 1px 18px rgb(6 18 40 / 0.5); }

  @media (min-width: 640px) {
    .gf > li { flex: 0 1 calc((100% - var(--s-4)) / 2); }
  }
  @media (min-width: 1024px) {
    .gf { gap: var(--s-5); }
    .gf > li { flex: 0 1 calc((100% - var(--s-5) * 2) / 3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gf-item :global(.gf-foto), .gf-item::after { transition: none; }
  }
</style>
